# Copy to .env.local for local development. Replace placeholders only.
# Server-only values must never use a NEXT_PUBLIC_ prefix.

# Supabase
# Required | public: browser + server
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Required | public: browser + server
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Required | server-only
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
# Optional | server-only: Edge Function
SUPABASE_URL=https://your-project.supabase.co

# Public application URL
# Optional | public
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional | public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional | server-only
SITE_URL=http://localhost:3000
# Optional | server-only
VERCEL_URL=localhost:3000

# Session and scheduled jobs
# Recommended | server-only: at least 32 characters
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required for cron routes | server-only: at least 32 characters
CRON_SECRET=replace-with-at-least-32-random-characters

# SendGrid email
# Optional | server-only
SENDGRID_API_KEY=your-sendgrid-api-key
# Optional | server-only
SENDGRID_FROM_EMAIL=noreply@example.com

# Push notifications
# Optional | public
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key
# Optional | server-only
VAPID_PUBLIC_KEY=your-public-vapid-key
# Optional | server-only
VAPID_PRIVATE_KEY=your-private-vapid-key
# Optional | server-only
VAPID_SUBJECT=mailto:admin@example.com
# Optional | server-only
PUSH_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Content moderation
# Optional | server-only
CONTENT_MODERATION_API_URL=https://moderation-provider.example.com
# Optional | server-only
CONTENT_MODERATION_API_KEY=your-moderation-api-key

# GIF provider
# Optional | server-only
GIF_API_PROVIDER=giphy
# Optional | server-only
GIF_API_KEY=your-gif-api-key
# Optional | server-only
GIPHY_API_KEY=your-giphy-api-key
# Optional | public
NEXT_PUBLIC_GIPHY_API_KEY=your-public-giphy-key
# Optional | server-only
TENOR_API_KEY=your-tenor-api-key

# Weather and geocoding
# Optional | server-only
OPENWEATHER_API_KEY=your-openweather-api-key
# Optional | server-only
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Operational scripts
# Optional | server-only
SEED_STAFF_PASSWORD=replace-with-a-temporary-staff-password
# Optional | server-only
EDGE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Optional | server-only
BASE_URL=http://localhost:3000
# Optional | server-only
TEST_BASE_URL=http://localhost:3000
